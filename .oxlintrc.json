{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "vue", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "env": {
    "browser": true
  },
  "ignorePatterns": ["dist/**", "src-tauri/target/**"],
  "overrides": [
    {
      "files": ["vite.config.ts"],
      "env": {
        "browser": false,
        "node": true
      }
    },
    {
      "files": ["**/__tests__/**"],
      "env": {
        "vitest": true
      }
    }
  ]
}
